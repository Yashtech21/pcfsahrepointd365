{
  "name": "d365-sp-docmanager-api",
  "version": "1.0.0",
  "private": true,
  "description": "Azure Function backend for the CategorizedDocManager PCF control (SharePoint via Microsoft Graph, app-only)",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@azure/functions": "^4.6.0",
    "@azure/identity": "^4.5.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.6.3"
  }
}
