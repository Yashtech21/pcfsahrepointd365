<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="EnterpriseDocManagement"
           constructor="CategorizedDocManager"
           version="1.1.0"
           display-name-key="Categorized Document Manager"
           description-key="SharePoint document manager with categorization, unified contact view and inline preview"
           control-type="virtual">
    <external-service-usage enabled="true">
      <domain>login.microsoftonline.com</domain>
    </external-service-usage>

    <property name="contactLookupField" display-name-key="Contact Lookup"
              description-key="Bound lookup pointing to the Contact (recruit) record"
              of-type="Lookup.Simple" usage="bound" required="true" />

    <!-- Connection settings come from the environment variables ce_DocManagerApiBaseUrl, ce_DocManagerTenantId,
         ce_DocManagerClientId and ce_DocManagerApiScope. These properties are optional per-form overrides. -->
    <property name="apiBaseUrl" display-name-key="API Base URL (optional override)"
              description-key="Leave empty to use environment variable ce_DocManagerApiBaseUrl"
              of-type="SingleLine.Text" usage="input" required="false" />
    <property name="tenantId" display-name-key="Entra Tenant ID (optional override)"
              description-key="Leave empty to use environment variable ce_DocManagerTenantId"
              of-type="SingleLine.Text" usage="input" required="false" />
    <property name="clientId" display-name-key="SPA Client ID (optional override)"
              description-key="Leave empty to use environment variable ce_DocManagerClientId"
              of-type="SingleLine.Text" usage="input" required="false" />
    <property name="apiScope" display-name-key="API Scope (optional override)"
              description-key="Leave empty to use environment variable ce_DocManagerApiScope"
              of-type="SingleLine.Text" usage="input" required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
      <css path="css/CategorizedDocManager.css" order="1" />
    </resources>
    <feature-usage>
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
